{
  "name": "vscode-hg",
  "displayName": "Mercurial (Hg)",
  "description": "Mercurial source control integration for VS Code",
  "version": "0.1.0",
  "publisher": "tadashi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tadashi-k/vscode-hg"
  },
  "engines": {
    "vscode": "^1.99.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "workspaceContains:.hg/hgrc",
    "workspaceContains:.hg/requires"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "hg.refresh",
        "title": "Refresh",
        "category": "Mercurial",
        "icon": "$(refresh)"
      },
      {
        "command": "hg.commit",
        "title": "Commit",
        "category": "Mercurial",
        "icon": "$(check)"
      },
      {
        "command": "hg.commitAll",
        "title": "Commit All",
        "category": "Mercurial"
      },
      {
        "command": "hg.add",
        "title": "Add",
        "category": "Mercurial"
      },
      {
        "command": "hg.revert",
        "title": "Revert Changes",
        "category": "Mercurial"
      },
      {
        "command": "hg.clean",
        "title": "Clean Untracked Files",
        "category": "Mercurial"
      },
      {
        "command": "hg.deleteFile",
        "title": "Delete",
        "category": "Mercurial"
      },
      {
        "command": "hg.showDiff",
        "title": "Show Diff",
        "category": "Mercurial"
      },
      {
        "command": "hg.openFile",
        "title": "Open File",
        "category": "Mercurial",
        "icon": "$(go-to-file)"
      },
      {
        "command": "hg.annotate",
        "title": "Toggle Annotate",
        "category": "Mercurial",
        "icon": "$(versions)"
      },
      {
        "command": "hg.showRevisionDetails",
        "title": "Show Revision Details",
        "category": "Mercurial"
      },
      {
        "command": "hg.showRevisionDiff",
        "title": "Show Revision Diff",
        "category": "Mercurial"
      },
      {
        "command": "hg.showFileDiffAtRevision",
        "title": "Show File Diff at Revision",
        "category": "Mercurial"
      },
      {
        "command": "hg.updateToRevision",
        "title": "Update to Revision",
        "category": "Mercurial"
      },
      {
        "command": "hg.graph.revealLatest",
        "title": "Reveal Latest Commit",
        "category": "Mercurial"
      },
      {
        "command": "hg.copyCommitHash",
        "title": "Copy Commit Hash",
        "category": "Mercurial"
      },
      {
        "command": "hg.copyCommitMessage",
        "title": "Copy Commit Message",
        "category": "Mercurial"
      },
      {
        "command": "hg.checkoutBranch",
        "title": "Checkout Branch",
        "category": "Mercurial",
        "icon": "$(git-branch)"
      }
    ],
    "views": {
      "scm": [
        {
          "id": "hg.graph",
          "name": "Graph",
          "icon": "$(git-graph)",
          "when": "hg.repoCount >= 1 && config.hg.showGraphInView != false"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "hg.refresh",
          "group": "navigation",
          "when": "view == hg.graph"
        }
      ],
      "view/item/context": [
        {
          "command": "hg.showRevisionDetails",
          "when": "view == hg.graph && viewItem == hg.commit",
          "group": "1_details"
        },
        {
          "command": "hg.showRevisionDiff",
          "when": "view == hg.graph && viewItem == hg.commit",
          "group": "1_details"
        },
        {
          "command": "hg.updateToRevision",
          "when": "view == hg.graph && viewItem == hg.commit",
          "group": "2_update"
        },
        {
          "command": "hg.copyCommitHash",
          "when": "view == hg.graph && viewItem == hg.commit",
          "group": "3_copy"
        },
        {
          "command": "hg.copyCommitMessage",
          "when": "view == hg.graph && viewItem == hg.commit",
          "group": "3_copy"
        }
      ],
      "editor/title": [
        {
          "command": "hg.annotate",
          "group": "navigation",
          "when": "hg.repoCount >= 1 && resourceScheme != hg"
        }
      ],
      "scm/title": [
        {
          "command": "hg.commit",
          "group": "navigation",
          "when": "scmProvider == hg"
        },
        {
          "command": "hg.refresh",
          "group": "navigation",
          "when": "scmProvider == hg"
        }
      ],
      "scm/resourceGroup/context": [
        {
          "command": "hg.commitAll",
          "when": "scmProvider == hg",
          "group": "inline"
        },
        {
          "command": "hg.clean",
          "when": "scmProvider == hg",
          "group": "1_modification"
        }
      ],
      "scm/resourceState/context": [
        {
          "command": "hg.add",
          "when": "scmProvider == hg && (scmResourceGroup == working || scmResourceGroup == untracked)",
          "group": "1_modification"
        },
        {
          "command": "hg.deleteFile",
          "when": "scmProvider == hg && scmResourceGroup == untracked",
          "group": "1_modification"
        },
        {
          "command": "hg.revert",
          "when": "scmProvider == hg && scmResourceGroup == working",
          "group": "1_modification"
        },
        {
          "command": "hg.showDiff",
          "when": "scmProvider == hg && scmResourceGroup != untracked",
          "group": "2_view"
        },
        {
          "command": "hg.openFile",
          "when": "scmProvider == hg",
          "group": "2_view"
        }
      ]
    },
    "colors": [
      {
        "id": "hgDecoration.modifiedResourceForeground",
        "description": "Badge color for files modified in the working copy",
        "defaults": {
          "light": "#9a7b00",
          "dark": "#c9a53a",
          "highContrast": "#c9a53a",
          "highContrastLight": "#9a7b00"
        }
      },
      {
        "id": "hgDecoration.addedResourceForeground",
        "description": "Badge color for files added to the working copy",
        "defaults": {
          "light": "#3c8746",
          "dark": "#81b88b",
          "highContrast": "#81b88b",
          "highContrastLight": "#3c8746"
        }
      },
      {
        "id": "hgDecoration.removedResourceForeground",
        "description": "Badge color for files removed (hg remove) in the working copy",
        "defaults": {
          "light": "#9e121d",
          "dark": "#c74e59",
          "highContrast": "#c74e59",
          "highContrastLight": "#9e121d"
        }
      },
      {
        "id": "hgDecoration.deletedResourceForeground",
        "description": "Badge color for files deleted from the working copy",
        "defaults": {
          "light": "#9e121d",
          "dark": "#c74e59",
          "highContrast": "#c74e59",
          "highContrastLight": "#9e121d"
        }
      },
      {
        "id": "hgDecoration.untrackedResourceForeground",
        "description": "Badge color for untracked files",
        "defaults": {
          "light": "#6c6c6c",
          "dark": "#9d9d9d",
          "highContrast": "#9d9d9d",
          "highContrastLight": "#6c6c6c"
        }
      }
    ],
    "configuration": {
      "title": "Mercurial",
      "properties": {
        "hg.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Whether Mercurial integration is enabled"
        },
        "hg.path": {
          "type": "string",
          "default": "hg",
          "description": "Path to the hg executable"
        },
        "hg.autoRefresh": {
          "type": "boolean",
          "default": true,
          "description": "Refresh repository status automatically when files change"
        },
        "hg.historyLimit": {
          "type": "number",
          "default": 200,
          "description": "Maximum number of revisions to load in the history graph view"
        },
        "hg.showGraphInView": {
          "type": "boolean",
          "default": true,
          "description": "Show the Graph view in the Source Control view container"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && vscode-test",
    "vscode:prepublish": "npm run compile",
    "package": "npm run compile && vsce package",
    "package:install": "npm run package && code --install-extension vscode-hg-*.vsix"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.99.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.1",
    "mocha": "^12.0.3",
    "typescript": "^5.8.0"
  }
}
